# --- AI (Groq) ---
GROQ_API_KEY=
MODEL=openai/gpt-oss-20b

# --- Database (MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=spike_ai

# --- Security ---
# Generate a long random secret, e.g. via: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- CORS ---
# Comma-separated list of allowed origins
FRONTEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000

# --- Spike Agent provider abstraction (optional; Chat stays on Groq) ---
# LLM_PROVIDER=groq|openrouter|gemini|openai_compatible|ollama  (default groq)
LLM_PROVIDER=groq
# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-20b
# Gemini (OpenAI-compat endpoint)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.0-flash
# Generic OpenAI-compatible (Ollama / LM Studio / llama.cpp)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
# Ollama (local, no GPU required)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1
# Agent iteration limits
AGENT_MAX_STEPS=60
AGENT_MAX_RETRIES=3
AGENT_MAX_TOOL_CALLS=120

# --- Optional providers ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WEB_SEARCH_API_KEY=
IMAGE_GENERATION_API_KEY=

# --- Vision / image understanding (multimodal) ---
# OpenAI-compatible vision endpoint. Defaults to Pollinations' free vision proxy
# (no key required). To use OpenAI/others set:
#   VISION_BASE_URL=https://api.openai.com/v1
#   VISION_MODEL=gpt-4o-mini
#   VISION_API_KEY=sk-...
VISION_BASE_URL=https://text.pollinations.xyz/v1
VISION_MODEL=openai
VISION_API_KEY=
# Image generation reuses the OpenAI key above by default (IMAGE_GENERATION_API_KEY
# falls back to VISION_API_KEY). It calls <IMAGE_GEN_BASE_URL>/images/generations.
IMAGE_GENERATION_API_KEY=
IMAGE_GEN_BASE_URL=https://api.openai.com/v1
